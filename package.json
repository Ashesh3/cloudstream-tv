{
  "name": "cloudframe",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @cloudframe/tv && npm run build -w @cloudframe/admin && node scripts/build-site.mjs",
    "dev:tv": "npm run dev -w @cloudframe/tv",
    "dev:admin": "npm run dev -w @cloudframe/admin",
    "lint": "eslint apps packages api tests scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.base.json --noEmit"
  },
  "dependencies": {
    "@cloudframe/shared": "*",
    "@cloudframe/server": "*",
    "@cloudframe/providers": "*",
    "@cloudframe/indexer": "*",
    "@google-cloud/firestore": "^9.0.0",
    "@node-rs/argon2": "^2.1.0",
    "@vercel/oidc": "^3.8.5",
    "workflow": "^4.8.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "jsdom": "^29.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
