{
  "name": "cloudframe",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @cloudframe/tv && npm run build -w @cloudframe/admin && node scripts/build-site.mjs",
    "build:e2e": "cross-env CLOUDFRAME_E2E_BUILD=1 npm run build",
    "build:vercel": "npm run build && node scripts/build-vercel.mjs",
    "build:server": "npm run build && node scripts/build-server.mjs",
    "check:chromium68": "node scripts/check-chromium68.mjs",
    "dev:tv": "npm run dev -w @cloudframe/tv",
    "dev:admin": "npm run dev -w @cloudframe/admin",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.base.json --noEmit && tsc -p apps/tv/tsconfig.json --noEmit && tsc -p apps/admin/tsconfig.json --noEmit",
    "start": "node build/self-hosted/server/index.js"
  },
  "dependencies": {
    "@cloudframe/shared": "*",
    "@cloudframe/server": "*",
    "@cloudframe/providers": "*",
    "@google-cloud/firestore": "^9.0.0",
    "@node-rs/argon2": "^2.1.0",
    "@vercel/blob": "2.8.0",
    "@vercel/functions": "3.9.5",
    "@vercel/oidc": "^3.8.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "jsdom": "^29.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.1.11",
    "ws": "^8.18.3"
  },
  "optionalDependencies": {
    "@node-rs/argon2-linux-arm64-gnu": "2.1.0",
    "@node-rs/argon2-linux-x64-gnu": "2.1.0"
  },
  "engines": {
    "node": ">=24.5.0"
  }
}
