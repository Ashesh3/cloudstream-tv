{
  "api": {
    "regions": ["bom1"],
    "runtime": "nodejs24.x",
    "maxDuration": 300,
    "memory": 1024
  },
  "routes": [
    {
      "src": "^/cloudframe-media-sw\\.js$",
      "headers": { "cache-control": "no-cache" },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "^/api(?:/.*)?$", "dest": "/api" },
    { "src": "^/admin(?:/.*)?$", "dest": "/admin/index.html" },
    { "src": "^/(?!api(?:/|$)).*$", "dest": "/index.html" }
  ]
}
