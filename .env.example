# Exact public HTTPS origin used by televisions, administrators, and OAuth redirects.
APP_ORIGIN=

# Single HTTP listener inside the container and persistent local data directory.
PORT=8080
DATA_DIR=/data

# Optional provider OAuth credentials. Configure either complete pair or omit it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_TENANT=common

# Transcode resource policy.
TRANSCODE_CACHE_MAX_BYTES=50GiB
TRANSCODE_CACHE_MIN_FREE_BYTES=5GiB
TRANSCODE_FIRST_SEGMENT_TIMEOUT_SECONDS=30
TRANSCODE_THREADS=auto
LOG_LEVEL=info
