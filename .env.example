NEXT_PUBLIC_APP_URL=

# Household and authoritative private Vercel storage
HOUSEHOLD_ID=
BLOB_STORE_ID=
CONTROL_PLANE_ENV=

# Firestore recovery writer
FIRESTORE_PROJECT_ID=
FIRESTORE_DATABASE_ID=
FIRESTORE_EMULATOR_HOST=
GCP_WORKLOAD_IDENTITY_PROVIDER=
GCP_SERVICE_ACCOUNT_EMAIL=

# Operator-only migration/recovery identity (do not configure in Vercel runtime)
GCP_OPERATOR_SERVICE_ACCOUNT_EMAIL=
GCP_OPERATOR_CREDENTIALS_FILE=

# Provider OAuth (server only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_TENANT=

# Server-only security material
ADMIN_INITIAL_PASSPHRASE=
ADMIN_PASSPHRASE_PEPPER=
CSRF_SECRET=
CONTROL_PLANE_KEY_VERSION=v1
CONTROL_PLANE_KEY_V1=
SESSION_KEY_VERSION=v1
SESSION_KEY_V1=
BROWSE_HANDLE_KEY_VERSION=v1
BROWSE_HANDLE_KEY_V1=
BROWSE_ID_SECRET=
ROOT_ID_SECRET=
