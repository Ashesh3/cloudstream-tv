    { "name": "Admin Frame", "kind": "nav", "refersTo": "AppShell Layout SideNav MobileNav", "description": "One responsive Astryx frame for Requests, Devices, Sources, and Settings.", "html": "<nav class=\"ds-admin-frame\"><strong>Cloudframe</strong><span>Household admin</span><button>Requests</button><button class=\"is-selected\">Devices</button><button>Sources</button><button>Settings</button></nav>", "css": ".ds-admin-frame{display:grid;gap:12px;width:240px;padding:20px;background:var(--color-background-surface);color:var(--color-text-primary);border-right:1px solid var(--color-border);font-family:var(--font-family-body)}.ds-admin-frame span{color:var(--color-text-secondary)}.ds-admin-frame button{min-height:40px;padding:0 12px;border:0;border-radius:var(--radius-element);background:transparent;color:inherit;text-align:left}.ds-admin-frame button:hover,.ds-admin-frame button.is-selected{background:var(--color-background-selected)}.ds-admin-frame button:focus-visible{outline:var(--focus-outline-width) solid var(--focus-outline-color);outline-offset:var(--focus-outline-offset)}" },
