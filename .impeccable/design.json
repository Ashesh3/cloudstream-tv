    { "name": "Operational Status", "kind": "chip", "refersTo": "StatusDot Token Banner ProgressBar", "description": "Semantic primitives communicate real source, access, and transcoder state.", "html": "<span class=\"ds-status\"><i></i>Connected</span>", "css": ".ds-status{display:inline-flex;align-items:center;gap:8px;padding:6px 10px;border-radius:9999px;background:var(--color-success-muted);color:var(--color-text-primary);font:600 14px var(--font-family-body)}.ds-status i{width:8px;height:8px;border-radius:9999px;background:var(--color-success)}" },
